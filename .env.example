# 本地直接运行；请复制为 .env.local 并填写，不要提交或分发实际配置。
# 临时免登录可设为 local，仅允许本机直接访问；恢复登录改回 password。
AUTH_MODE=password
API_HOST=127.0.0.1
API_PORT=8787
DATA_DIR=./data
# 默认聊天 / 上传辅助 / 智能体模型（管理员也可在「模型与服务配置」页改）
# DeepSeek：
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
# 或通义千问（阿里云百炼 OpenAI 兼容）：
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen3.8-max
AI_API_KEY=
DASHSCOPE_API_KEY=
# 扫描件 / 图片 / 视频抽帧视觉识别（独立于聊天默认模型；失败回退本地 OCR）
AI_VISION_MODEL=qwen-vl-plus
# PARSE_USE_QWEN=false 可关闭解析侧千问视觉

# 中文语义向量默认在本地生成，公开模型随完整交付包提供。
LOCAL_EMBEDDINGS_ENABLED=true
# 可选独立向量服务：须同时配置模型、接口和对应密钥。不要填写 DeepSeek 聊天接口。
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# 只允许同步这些已有目录；多个目录以分号分隔（Windows/Linux 均如此）。
CONNECTOR_ROOTS=./knowledge-sources
# 自动备份间隔小时数；0=关闭。在线手工备份始终可用。
BACKUP_INTERVAL_HOURS=0
# 外部部署应设为浏览器实际访问的 HTTPS 地址；多个来源以英文逗号分隔。
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787,http://127.0.0.1:8787
PUBLIC_ORIGIN=
COOKIE_SECURE=false
# 企业 HTTPS 内网模型：精确主机名白名单；不用于放开 Webhook 地址。
MODEL_ALLOWED_HOSTS=
# 容器或远程首次部署可安全注入首位管理员，初始化成功后移除此三项。
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=
# 可选 OIDC 统一登录，回调地址为 PUBLIC_ORIGIN/api/auth/sso/callback。
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=企业统一登录
# 默认使用离线 JS OCR；可选原生 Tesseract 与 Poppler 绝对路径提高吞吐量。
TESSERACT_PATH=
PDFTOPPM_PATH=
# 可选从密钥管理器注入。启用后须独立备份，恢复时必须保留同一值。
# APP_ENCRYPTION_KEY=

# Local media transcription (optional). See docs/数据接入与核验配置说明.md.
# KNOWLEDGE_ASR_COMMAND=C:/absolute/path/to/asr-env/Scripts/python.exe
# KNOWLEDGE_ASR_ARGS='["D:/absolute/project/scripts/asr-local.py"]'
# KNOWLEDGE_ASR_TIMEOUT_MS=600000
# KNOWLEDGE_FFMPEG_COMMAND=C:/absolute/path/to/ffmpeg.exe
# Remote read-only source allowlists must be configured explicitly.
# KNOWLEDGE_WEB_ALLOWED_HOSTS=docs.example.com
# KNOWLEDGE_API_ALLOWED_ENDPOINTS=https://api.example.com/read-only/assets